# ClaimGuard AI settings. Copy to a file named exactly .env and fill in.
# Only .env is git-ignored: .env.local, .env.prod and similar names are NOT,
# and would be committed. Never commit a real key, or paste it in an issue,
# a screenshot or a log.
#
# None of this is needed for a clean run: with no key, the pack's mock
# explains findings and the run completes offline.
# claimguard reads these from the environment; it does not load .env itself.

# Model access, once the team has agreed it with the mentor.
# While no live provider is wired, a key here is noticed but not used.
ANTHROPIC_API_KEY=

# Model ID for the live provider (recorded in the run manifest).
CLAIMGUARD_MODEL=

# Seconds before a model call falls back to the deterministic explanation.
# Between 0 and 300; default 20.
CLAIMGUARD_AI_TIMEOUT_S=20
